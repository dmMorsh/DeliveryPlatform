{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;Maximum Pool Size=10;Application Name=CartPG;"
  },
  "Kafka": {
    "Brokers": "localhost:29092",
    "GroupId": "cart-service-group",
    "DefaultTopic": "cart.events",
    "Topics": ["order.events", "cart.events", "retry.events", "dlq.events"],
    "Retry": {
      "Topic": "retry.events",
      "MaxAttempts": 3,
      "MaxAgeSeconds": 3600
    },
    "Backpressure": {
      "MaxLag": 10000,
      "DelayMs": 200
    },
    "PoisonEventTypes": [],
    "DefaultPartitions": "3",
    "DefaultReplicationFactor": "1"
  },
  "gRPC": {
    "OrderService": {
      "Url": "https://localhost:7204"
    }
  },
  "Http": {
    "TimeoutSeconds": 10
  },
  "Jwt": {
    "Key": "SUPER_PUPER_SECRET_KEY_I_LOVE_MAKING_KEYS_UP",
    "Issuer": "identity-service",
    "Audience": "platform-api",
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CartCache": {
    "TtlSeconds": 3600
  },
  "AllowedHosts": "*"
}
