{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;",
    "InventoryShard0": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;",
    "InventoryShard1": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;"
  },
  "ShardCount": 1,
  "DefaultShard": 0,
  "Inventory": {
    "ReservationAlertEnabled": true,
    "ReservationAlertTtlMinutes": 120,
    "ReservationAlertBatchSize": 200,
    "ReservationAlertMaxBatches": 20,
    "ReservationAlertCron": "0 4 * * *"
  },
  
  "Kafka": {
    "Brokers": "localhost:29092",
    "GroupId": "inventory-service-group",
    "DefaultTopic": "inventory.events",
    "Topics": ["order.events", "inventory.events", "retry.events", "dlq.events"],
    "Retry": {
      "Topic": "retry.events",
      "MaxAttempts": 3,
      "MaxAgeSeconds": 3600
    },
    "Backpressure": {
      "MaxLag": 10000,
      "DelayMs": 200
    },
    "PoisonEventTypes": [],
    "DefaultPartitions": "3",
    "DefaultReplicationFactor": "1"
  },
  "Hangfire": {
    "ProcessedCommandRetentionDays": 7
  },
  "Jwt": {
    "Key": "SUPER_PUPER_SECRET_KEY_I_LOVE_MAKING_KEYS_UP",
    "Issuer": "identity-service",
    "Audience": "platform-api",
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
