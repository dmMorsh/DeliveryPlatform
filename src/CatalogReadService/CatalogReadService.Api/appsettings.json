{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Brokers": "localhost:29092",
    "GroupId": "catalog-read-service-group",
    "DefaultTopic": "product.events",
    "Topics": ["inventory.events", "product.events", "retry.events", "dlq.events"],
    "Retry": {
      "Topic": "retry.events",
