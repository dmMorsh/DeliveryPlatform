      "MaxLag": 10000,
      "DelayMs": 200
    },
    "PoisonEventTypes": [],
    "DefaultPartitions": "3",
    "DefaultReplicationFactor": "1"
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "Jwt": {
    "Key": "SUPER_PUPER_SECRET_KEY_I_LOVE_MAKING_KEYS_UP",
    "Issuer": "identity-service",
    "Audience": "platform-api",
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
