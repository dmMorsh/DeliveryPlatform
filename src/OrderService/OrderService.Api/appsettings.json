{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "ConnectionStrings": {
        "PostgreSQL": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;",
        "OrderReadStore": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;",
        "OrderShard0": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;",
        "OrderShard1": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;"
    },
    "ShardCount": 1,
    
    "USE_INMEMORY_DB": false,
    "Order": {
        "PaymentTtlEnabled": true,
        "PaymentTtlMinutes": 15,
        "PaymentTtlBatchSize": 200,
        "PaymentTtlMaxBatches": 20,
        "PaymentTtlCron": "0 3 * * *",
        "AssigningTtlEnabled": true,
        "AssigningTtlMinutes": 30,
        "AssigningTtlBatchSize": 200,
        "AssigningTtlMaxBatches": 20,
        "AssigningTtlCron": "0 5 * * *",
        "KitchenAcceptTtlEnabled": true,
        "KitchenAcceptTtlMinutes": 30,
        "KitchenAcceptTtlBatchSize": 200,
        "KitchenAcceptTtlMaxBatches": 20,
        "KitchenAcceptTtlCron": "0 6 * * *",
        "KitchenDelayEnabled": true,
        "KitchenDelayBatchSize": 200,
        "KitchenDelayMaxBatches": 20,
        "KitchenDelayCron": "0 12 * * *"
    },
    "Kitchen": {
        "Enabled": true,
        "SlotMinutes": 15,
        "MaxOrdersPerSlot": 20,
        "PreparationMinutes": 30,
        "LookaheadSlots": 8,
        "PauseMinutesOnOverload": 10
    },
    "DeliveryZones": {
        "Enabled": false,
        "UseToCoordinates": true,
        "Zones": [
            {
                "Id": "center",
                "Name": "Center",
                "CenterLatitude": 55.751244,
                "CenterLongitude": 37.618423,
                "RadiusKm": 12,
                "PickupSlaMinutes": 45,
                "TransitSlaMinutes": 120,
                "DeliveryFeeMultiplier": 1.0
            }
        ]
    },
    "Kafka": {
        "Brokers": "localhost:29092",
        "GroupId": "order-service-group",
        "DefaultTopic": "order.events",
        "Topics": ["order.events", "courier.events", "inventory.events", "cart.events", "payment.events", "retry.events", "dlq.events"],
        "Retry": {
            "Topic": "retry.events",
            "MaxAttempts": 3,
            "MaxAgeSeconds": 3600
        },
        "Backpressure": {
            "MaxLag": 10000,
            "DelayMs": 200
        },
        "PoisonEventTypes": []
    },
    "Jwt": {
        "Key": "SUPER_PUPER_SECRET_KEY_I_LOVE_MAKING_KEYS_UP",
        "Issuer": "identity-service",
        "Audience": "platform-api",
        "ClockSkewSeconds": 60
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "AllowedHosts": "*"
