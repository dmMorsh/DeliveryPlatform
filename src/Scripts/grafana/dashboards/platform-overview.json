{
  "uid": "platform-overview",
  "title": "Platform Overview",
  "tags": ["platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Targets Up",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(up)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scrape Duration (p95)",
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scrape_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU Time (Total)",
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(process_cpu_time_seconds_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process Memory RSS (Sum)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dotnet GC Heap (Sum)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(dotnet_total_memory_bytes)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Server Duration p95 (Best Effort)",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_seconds_bucket[5m]))) or histogram_quantile(0.95, sum by (le) (rate(aspnetcore_request_duration_seconds_bucket[5m]))) or histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m]))) or histogram_quantile(0.95, sum by (le) (rate(kestrel_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}
