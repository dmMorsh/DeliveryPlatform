{
  "uid": "service-overview",
  "title": "Service Overview",
  "tags": ["service", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "links": [
    {
      "type": "link",
      "title": "View traces (Tempo)",
      "url": "/explore?orgId=1&left=%7B%22datasource%22:%22Tempo%22,%22queries%22:%5B%7B%22query%22:%22%7B%20resource.service.name%20=%20%5C%22$service%5C%22%20%7D%22,%22refId%22:%22A%22%7D%5D%7D",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "query": "label_values(process_cpu_time_seconds_total, exported_job)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests/sec",
      "links": [
        {
          "title": "View traces (Tempo)",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22Tempo%22,%22queries%22:%5B%7B%22query%22:%22%7B%20resource.service.name%20=%20%5C%22$service%5C%22%20%7D%22,%22refId%22:%22A%22%7D%5D%7D&from=${__from}&to=${__to}",
          "targetBlank": true
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error % (5xx)",
      "links": [
        {
          "title": "View traces (Tempo)",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22Tempo%22,%22queries%22:%5B%7B%22query%22:%22%7B%20resource.service.name%20=%20%5C%22$service%5C%22%20%7D%22,%22refId%22:%22A%22%7D%5D%7D&from=${__from}&to=${__to}",
          "targetBlank": true
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{exported_job=~\"$service\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Requests",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(http_server_active_requests{exported_job=~\"$service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP p95 (s)",
      "links": [
        {
          "title": "View traces (Tempo)",
          "url": "/explore?orgId=1&left=%7B%22datasource%22:%22Tempo%22,%22queries%22:%5B%7B%22query%22:%22%7B%20resource.service.name%20=%20%5C%22$service%5C%22%20%7D%22,%22refId%22:%22A%22%7D%5D%7D&from=${__from}&to=${__to}",
          "targetBlank": true
        }
      ],
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$service\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (sec/s)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(process_cpu_time_seconds_total{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage (bytes)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (process_memory_usage_bytes{exported_job=~\"$service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Heap (bytes)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (process_runtime_dotnet_gc_heap_size{exported_job=~\"$service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Exceptions/sec",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(process_runtime_dotnet_exceptions_count_total{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 by Service (s)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$service\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Delivery Assignment (per 5m)",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(delivery_assignment_enqueue_total[5m]))",
          "refId": "A",
          "legendFormat": "enqueue"
        },
        {
          "expr": "sum(rate(delivery_assignment_dequeue_total[5m]))",
          "refId": "B",
          "legendFormat": "dequeue"
        },
        {
          "expr": "sum(rate(delivery_assignment_offer_success_total[5m]))",
          "refId": "C",
          "legendFormat": "offer_success"
        },
        {
          "expr": "sum(rate(delivery_assignment_offer_retry_total[5m]))",
          "refId": "D",
          "legendFormat": "offer_retry"
        },
        {
          "expr": "sum(rate(delivery_assignment_reconcile_total[5m]))",
          "refId": "E",
          "legendFormat": "reconcile"
        }
      ]
    }
  ]
}
