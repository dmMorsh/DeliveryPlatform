{
  "uid": "service-overview",
  "title": "Service Overview",
  "tags": ["service", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "query": "label_values(process_cpu_time_seconds_total, exported_job)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests/sec",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error % (5xx)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{exported_job=~\"$service\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Requests",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(http_server_active_requests{exported_job=~\"$service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP p95 (s)",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$service\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (sec/s)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(process_cpu_time_seconds_total{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage (bytes)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (process_memory_usage_bytes{exported_job=~\"$service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Heap (bytes)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (process_runtime_dotnet_gc_heap_size{exported_job=~\"$service\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Exceptions/sec",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(process_runtime_dotnet_exceptions_count_total{exported_job=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 by Service (s)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$service\"}[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}
