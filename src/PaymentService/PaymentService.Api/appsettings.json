      "Shards": [
        {
          "Name": "payments-0",
          "ConnectionString": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;"
        },
        {
          "Name": "payments-1",
          "ConnectionString": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;"
        }
      ]
    },
    "ShardMap": {
      "ConnectionString": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;"
    },
    "StatusCheck": {
      "DelaysSeconds": [30, 120, 300, 600, 1800]
    },
    "Webhooks": {
      "SharedSecret": "",
      "AllowedIps": []
    },
    "Sberbank": {
      "BaseUrl": "https://ecomtest.sberbank.ru/ecomm/gw/partner/api/v1",
      "RegisterPath": "/register.do",
      "RegisterPreAuthPath": "/registerPreAuth.do",
      "StatusPath": "/getOrderStatusExtended.do",
      "DepositPath": "/deposit.do",
      "ReversePath": "/reverse.do",
      "RefundPath": "/refund.do",
      "UserName": "",
      "Password": "",
      "ReturnUrl": "https://merchant.example.com/payment/success",
      "FailUrl": "https://merchant.example.com/payment/fail",
      "TimeoutSeconds": 30
    },
    "YooMoney": {
      "BaseUrl": "https://api.yookassa.ru",
      "StartPath": "/v3/payments",
      "StatusPath": "/v3/payments",
      "RefundPath": "/v3/refunds",
      "ShopId": "",
      "SecretKey": "",
      "ReturnUrl": "https://merchant.example.com/payment/success",
      "FailUrl": "https://merchant.example.com/payment/fail",
      "TimeoutSeconds": 30
    },
    "FakeProvider": {
      "BaseUrl": "http://localhost:5177",
