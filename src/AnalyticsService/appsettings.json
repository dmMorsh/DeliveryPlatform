{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Brokers": "localhost:29092",
    "GroupId": "analytics-service-group",
    "DefaultTopic": "events",
    "Topics": ["order.events", "payment.events", "courier.events", "cart.events", "retry.events", "dlq.events"],
    "Retry": {
      "Topic": "retry.events",
      "MaxAttempts": 3,
      "MaxAgeSeconds": 3600
    },
    "Backpressure": {
      "MaxLag": 10000,
      "DelayMs": 200
    },
    "PoisonEventTypes": []
  },
  "AllowedHosts": "*"
}
