{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;Maximum Pool Size=10;Application Name=DeliveryPG;"
  },
  "Delivery": {
    "Courier": {
      "HeartbeatTtlSeconds": 45,
      "MaxActiveDeliveries": 1,
      "AllowExtraWhenMinutesLeft": 10,
      "OfferAcceptWindowSeconds": 20
    },
    "Eta": {
      "Enabled": true,
      "AverageSpeedKmh": 25,
      "PickupBufferMinutes": 10,
      "MinTravelMinutes": 5
    },
    "SlaEnabled": true,
    "SlaPickupMinutes": 60,
    "SlaTransitMinutes": 180,
    "SlaBatchSize": 200,
    "SlaMaxBatches": 20,
    "SlaCron": "0 8,20 * * *",
    "ReassignMaxAttempts": 3,
    "ReassignCooldownMinutes": 10
  },
  "Kafka": {
    "Brokers": "localhost:29092",
    "GroupId": "delivery-service-group",
    "DefaultTopic": "delivery.events",
    "Topics": ["order.events", "courier.events", "retry.events", "dlq.events"],
    "Retry": {
      "Topic": "retry.events",
      "MaxAttempts": 3,
      "MaxAgeSeconds": 3600
    },
    "Backpressure": {
      "MaxLag": 10000,
      "DelayMs": 200
    },
    "PoisonEventTypes": [],
    "DefaultPartitions": "3",
    "DefaultReplicationFactor": "1"
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "gRPC": {
    "LocationTrackingService": {
      "Url": "https://localhost:7070"
    }
  },
  "Http": {
    "TimeoutSeconds": 10
  },
  "Jwt": {
    "Key": "SUPER_PUPER_SECRET_KEY_I_LOVE_MAKING_KEYS_UP",
    "Issuer": "identity-service",
    "Audience": "platform-api",
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
