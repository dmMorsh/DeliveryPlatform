@model List<ProductViewModel>

<h2>Catalog</h2>

<table>
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category</th>
        <th>Available</th>
        <th>Rating</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Name</td>
            <td>@p.Price @((p.Currency ?? "USD"))</td>
            <td>@(string.IsNullOrWhiteSpace(p.Category) ? "-" : p.Category)</td>
            <td>@p.QuantityAvailable</td>
            <td>@(p.Rating?.ToString("0.0") ?? "-")</td>
            <td>
                <a asp-action="Details" asp-route-id="@p.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
