@model ProductViewModel

<h2>@Model.Name</h2>

<p>@(Model.Description ?? "-")</p>
<p><strong>@Model.Price @((Model.Currency ?? "USD"))</strong></p>
<p><strong>@Model.WeightGrams gram</strong></p>
<p><strong>Available:</strong> @Model.QuantityAvailable</p>
<p><strong>Category:</strong> @(string.IsNullOrWhiteSpace(Model.Category) ? "-" : Model.Category)</p>
<p><strong>Brand:</strong> @(string.IsNullOrWhiteSpace(Model.Brand) ? "-" : Model.Brand)</p>
<p><strong>Rating:</strong> @(Model.Rating?.ToString("0.0") ?? "-")</p>
<p><strong>Colors:</strong> @(Model.Colors?.Length > 0 ? string.Join(", ", Model.Colors) : "-")</p>

<form method="post" asp-controller="Cart" asp-action="Add">
    <input type="hidden" name="productId" value="@Model.Id"/>
    <input type="hidden" name="name" value="@Model.Name"/>
    <input type="hidden" name="priceCents" value="@Model.PriceCents"/>
    <button type="submit">Add to cart</button>
</form>
