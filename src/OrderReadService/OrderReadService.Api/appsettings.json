{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;Maximum Pool Size=10;Application Name=OrderReadPG;",
    "OrderReadStore": "Host=localhost;Port=5432;Database=delivery_db;Username=postgres;Password=postgres;Maximum Pool Size=10;Application Name=OrderReadRS;"
  },
  
  "Kafka": {
    "Brokers": "localhost:29092",
    "GroupId": "order-service-group",
    "DefaultTopic": "order.events",
